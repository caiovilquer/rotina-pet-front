{
  "name": "pet-care-scheduler-front",
  "version": "1.0.0",
  "description": "Sistema moderno de agendamento e gerenciamento de cuidados para pets",
  "author": "Caio Vilquer <caiovilquer@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/caiovilquer/pet-care-front#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/caiovilquer/pet-care-front.git"
  },
  "bugs": {
    "url": "https://github.com/caiovilquer/pet-care-front/issues"
  },
  "keywords": [
    "angular",
    "typescript",
    "material-design",
    "pet-care",
    "scheduler",
    "veterinary",
    "google-maps"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run set-env && ng serve",
    "dev": "npm start",
    "start:dev": "npm run set-env && ng serve",
    "start:https": "npm run set-env && ng serve --proxy-config proxy.conf.https.json",
    "start:no-proxy": "npm run set-env && ng serve --proxy-config false",
    "build": "ng build --configuration=production",
    "build:prod": "node scripts/set-env.js && ng build --configuration=production",
    "build:vercel": "./scripts/build-prod.sh",
    "set-env": "node scripts/set-env.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.26",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.26",
    "@angular/compiler": "^20.3.26",
    "@angular/core": "^20.3.26",
    "@angular/forms": "^20.3.26",
    "@angular/google-maps": "^20.2.14",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.26",
    "@angular/router": "^20.3.26",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.26",
    "@types/google.maps": "^3.58.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
